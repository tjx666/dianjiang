{
  "name": "dianjiang",
  "version": "0.11.1",
  "description": "点将 — summon the right coding agent. Cross-vendor agent dispatch for Claude Code / Codex / Grok.",
  "type": "module",
  "license": "MIT",
  "author": "YuTengjing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjx666/dianjiang.git"
  },
  "homepage": "https://github.com/tjx666/dianjiang#readme",
  "bugs": {
    "url": "https://github.com/tjx666/dianjiang/issues"
  },
  "keywords": [
    "cli",
    "ai-agents",
    "claude-code",
    "codex",
    "grok",
    "agent-dispatch",
    "delegation"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "dianjiang": "dist/cli/bin.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun test && bun run test:package",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:package": "bun run scripts/package-smoke.ts",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "citty": "^0.2.2",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
